# Envoi des demandes de devis par email (page /contact) via Resend.
# 1) Crée un compte gratuit sur https://resend.com AVEC l'adresse gecinqcreative@gmail.com
# 2) Génère une API key (Dashboard → API Keys) et colle-la ci-dessous
# 3) Copie ce fichier en ".env.local" (non versionné) et relance `npm run dev`
#
# Avec l'expéditeur de test (onboarding@resend.dev), les mails ne partent QUE vers
# l'adresse du compte Resend (gecinqcreative@gmail.com) → parfait pour se notifier.
# Pour envoyer depuis ta propre adresse/domaine, vérifie un domaine sur Resend
# et renseigne CONTACT_FROM.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO=gecinqcreative@gmail.com
# CONTACT_FROM=GECINQ CREATIVE <contact@ton-domaine.ch>
